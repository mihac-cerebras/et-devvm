[Unit]
Description=Eternal Terminal server (user-level, non-root) — installed by et-devvm
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
EnvironmentFile=%h/.config/et-devvm/env

# Clean up before (re)starting so a restart never dies on a held port / stale
# socket / orphaned etterminal. All prefixed '-' so a no-op cleanup never
# blocks startup.
ExecStartPre=-/usr/bin/pkill -u %U -x etterminal
ExecStartPre=-/bin/sh -c 'command -v fuser >/dev/null 2>&1 && fuser -k ${ET_PORT}/tcp 2>/dev/null; sleep 1; true'
ExecStartPre=-/bin/rm -f %h/.local/et/etserver.fifo
ExecStartPre=/bin/mkdir -p %h/.local/et/log

ExecStart=%h/.local/bin/etserver --port ${ET_PORT} --serverfifo=%h/.local/et/etserver.fifo --logdir=%h/.local/et/log

# On stop, reap leftover etterminal children that ET does not clean up itself.
ExecStopPost=-/usr/bin/pkill -u %U -x etterminal

Restart=always
RestartSec=2
TimeoutStartSec=30
TimeoutStopSec=15
KillMode=mixed

[Install]
WantedBy=default.target
